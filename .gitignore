# AnimekoLocalGuard: our own signing material must never be committed.
# A committed keystore lets anyone sign builds that appear to come from this project.
/keystore/
*.jks
*.keystore

# AnimekoLocalGuard: local-only helper files, including any short-lived credential stubs.
.gh-token.tmp
/build-last.txt
/probe.txt
/gradle-probe/
/build-localguard/
/.scan-filelist.txt

# AnimekoLocalGuard: the local toolchain (JDK 21, Android SDK, Gradle 9.3.1, a multi-GB Gradle
# cache) and build outputs. Never published: machine-specific, enormous, and not source.
/.tools/
/artifacts/
/out/
*.apk
*.aab
*.apks

# AnimekoLocalGuard: raw measurement evidence, including pulls of the danmaku APIs and of the
# official Animeko APK. Kept locally for auditability; its conclusions are written up in docs/.
/docs/evidence/

# Local source files
**/local.kt

# Android build outputs
app/android/release
app/android/debug

